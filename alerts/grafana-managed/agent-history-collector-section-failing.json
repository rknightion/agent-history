{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "labels": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "name": "agent-history-collector-section-failing"
  },
  "spec": {
    "annotations": {
      "description": "agent_sessions_metrics_section_success_ratio is below 1 for this section, or agent_history_exporter_collection_errors_total increased for its collector in the last 30 minutes. Sections are isolated: the others keep updating while this one fails. Read the indexer logs for the section's error.",
      "summary": "The {{ $labels.section }} metric collector section is failing"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max by (section) ((min by (section) (agent_sessions_metrics_section_success_ratio{job=\"agent-history-index\"}) < bool 1) == 1 or label_replace((sum by (collector) (increase(agent_history_exporter_collection_errors_total{job=\"agent-history-index\"}[30m])) > bool 0) == 1, \"section\", \"$1\", \"collector\", \"(.*)\"))",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        "queryType": "instant",
        "relativeTimeRange": {
          "from": "15m",
          "to": "0s"
        }
      },
      "B": {
        "datasourceUID": "__expr__",
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "datasourceUID": "__expr__",
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              }
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "30m",
    "labels": {
      "domain": "observability",
      "page": "false",
      "service": "agent-history",
      "severity": "warning",
      "skipinvestigation": "true",
      "source": "agent-history"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "agent-history collector section failing",
    "trigger": {
      "interval": "1m"
    }
  }
}
