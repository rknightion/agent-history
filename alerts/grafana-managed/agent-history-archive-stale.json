{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "labels": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "name": "agent-history-archive-stale"
  },
  "spec": {
    "annotations": {
      "description": "The daily hot-to-cold archive has not written a successful receipt for 129600 seconds. Check the archive service's journal and the cold tier's availability.",
      "summary": "The latest session archive receipt is {{ $values.A.Value | humanizeDuration }} old"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "time() - max(agent_sessions_archive_receipt_timestamp_seconds{job=\"agent-history-index\"}) > 129600",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        "queryType": "instant",
        "relativeTimeRange": {
          "from": "15m",
          "to": "0s"
        }
      },
      "B": {
        "datasourceUID": "__expr__",
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "datasourceUID": "__expr__",
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              }
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "10m",
    "labels": {
      "domain": "observability",
      "page": "false",
      "service": "agent-history",
      "severity": "warning",
      "skipinvestigation": "true",
      "source": "agent-history"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "agent-history archive receipt stale",
    "trigger": {
      "interval": "1m"
    }
  }
}
