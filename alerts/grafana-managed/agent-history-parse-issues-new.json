{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "labels": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "name": "agent-history-parse-issues-new"
  },
  "spec": {
    "annotations": {
      "description": "agent_history_parse_issues_total for this kind rose in the last 6h. A new unknown_type or missing_field often means a harness changed its transcript format; query the catalogue's parse issues for the affected sessions.",
      "summary": "{{ $values.A.Value }} new {{ $labels.kind }} parse issues in the last 6h"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "(max by (kind) (agent_history_parse_issues_total{job=\"agent-history-index\"}) - max by (kind) (agent_history_parse_issues_total{job=\"agent-history-index\"} offset 6h) > 0) or (max by (kind) (agent_history_parse_issues_total{job=\"agent-history-index\"}) > 0 unless max by (kind) (agent_history_parse_issues_total{job=\"agent-history-index\"} offset 6h))",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        "queryType": "instant",
        "relativeTimeRange": {
          "from": "15m",
          "to": "0s"
        }
      },
      "B": {
        "datasourceUID": "__expr__",
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "datasourceUID": "__expr__",
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              }
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "0s",
    "labels": {
      "domain": "observability",
      "page": "false",
      "service": "agent-history",
      "severity": "warning",
      "skipinvestigation": "true",
      "source": "agent-history"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "agent-history new parse issues",
    "trigger": {
      "interval": "1m"
    }
  }
}
