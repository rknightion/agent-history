{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "labels": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "name": "agent-history-cold-filesystem-pressure"
  },
  "spec": {
    "annotations": {
      "description": "The permanent archive volume is above 90% used. Cold JSONL and version history are append-only and must not be pruned ad hoc.",
      "summary": "The cold session archive volume is {{ $values.A.Value | printf \"%.1f\" }}% used"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "100 * sum(agent_sessions_filesystem_bytes{job=\"agent-history-index\",tier=\"cold\",kind=\"used\"}) / sum(agent_sessions_filesystem_bytes{job=\"agent-history-index\",tier=\"cold\",kind=\"total\"}) > 90",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        "queryType": "instant",
        "relativeTimeRange": {
          "from": "15m",
          "to": "0s"
        }
      },
      "B": {
        "datasourceUID": "__expr__",
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "datasourceUID": "__expr__",
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              }
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "10m",
    "labels": {
      "domain": "observability",
      "page": "false",
      "service": "agent-history",
      "severity": "warning",
      "skipinvestigation": "true",
      "source": "agent-history"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "agent-history cold filesystem pressure",
    "trigger": {
      "interval": "1m"
    }
  }
}
