{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "labels": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "name": "agent-history-archive-timer-inactive"
  },
  "spec": {
    "annotations": {
      "description": "The archive timer is not active, or its systemd state series is absent. Cold archive and hot retention will not run until the timer is started.",
      "summary": "agent-session-archive.timer is not active"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "((max(node_systemd_unit_state{job=\"agent-sessions\",name=\"agent-session-archive.timer\",state=\"active\"}) < bool 1) == 1) or on() absent(node_systemd_unit_state{job=\"agent-sessions\",name=\"agent-session-archive.timer\",state=\"active\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        "queryType": "instant",
        "relativeTimeRange": {
          "from": "15m",
          "to": "0s"
        }
      },
      "B": {
        "datasourceUID": "__expr__",
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "datasourceUID": "__expr__",
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              }
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "10m",
    "labels": {
      "domain": "observability",
      "page": "true",
      "service": "agent-history",
      "severity": "critical",
      "source": "agent-history"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "agent-history archive timer inactive",
    "trigger": {
      "interval": "1m"
    }
  }
}
