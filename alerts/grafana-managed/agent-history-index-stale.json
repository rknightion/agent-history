{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "labels": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "name": "agent-history-index-stale"
  },
  "spec": {
    "annotations": {
      "description": "agent_history_last_success_timestamp_seconds is more than 1800 seconds old. The indexer refreshes every few minutes, so new transcripts are not reaching the catalogue. Check the indexer container and the agent-history index run failed alert for a failing pass. An absent series does not fire: agent-history-metrics-stale covers a stopped indexer.",
      "summary": "The agent-history index has not completed a successful pass for {{ $values.A.Value | humanizeDuration }}"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "time() - max(agent_history_last_success_timestamp_seconds{job=\"agent-history-index\"}) > 1800",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        "queryType": "instant",
        "relativeTimeRange": {
          "from": "15m",
          "to": "0s"
        }
      },
      "B": {
        "datasourceUID": "__expr__",
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "datasourceUID": "__expr__",
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              }
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "5m",
    "labels": {
      "domain": "observability",
      "page": "true",
      "service": "agent-history",
      "severity": "critical",
      "source": "agent-history"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "agent-history index pass stale",
    "trigger": {
      "interval": "1m"
    }
  }
}
