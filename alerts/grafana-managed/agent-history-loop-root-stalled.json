{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "labels": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "name": "agent-history-loop-root-stalled"
  },
  "spec": {
    "annotations": {
      "description": "A live loop root in this namespace has had no lane in flight for over 20 minutes. A deliberate pause or a drain can trigger it as easily as a stuck loop.",
      "summary": "{{ $labels.namespace }} has had no lane in flight for {{ $values.A.Value | humanizeDuration }}"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max by (namespace) (agent_efficiency_root_no_lane_seconds{job=\"agent-history-index\"}) > 1200",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        "queryType": "instant",
        "relativeTimeRange": {
          "from": "15m",
          "to": "0s"
        }
      },
      "B": {
        "datasourceUID": "__expr__",
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "datasourceUID": "__expr__",
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              }
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "5m",
    "labels": {
      "domain": "observability",
      "page": "false",
      "service": "agent-history",
      "severity": "warning",
      "skipinvestigation": "true",
      "source": "agent-history"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "agent-history loop root stalled",
    "trigger": {
      "interval": "1m"
    }
  }
}
