{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "labels": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "name": "agent-history-metrics-stale"
  },
  "spec": {
    "annotations": {
      "description": "agent_sessions_metrics_collection_runs_total from the agent-history-index service has not increased in 15m, is absent, or the last successful collection is more than 900 seconds old. The periodic indexer runs the metric collectors on its own thread; check that the indexer container is running with OTLP metric export configured, and look for telemetry.configuration.invalid in its OTLP logs. A single failing collector section fires agent-history-collector-section-failing instead.",
      "summary": "agent-history metric collection has stopped or stopped succeeding"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "((sum(increase(agent_sessions_metrics_collection_runs_total{job=\"agent-history-index\"}[15m])) < bool 1) == 1) or on() absent_over_time(agent_sessions_metrics_collection_runs_total{job=\"agent-history-index\"}[15m]) or on() (time() - max(agent_sessions_metrics_last_success_timestamp_seconds{job=\"agent-history-index\"}) > 900)",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        "queryType": "instant",
        "relativeTimeRange": {
          "from": "15m",
          "to": "0s"
        }
      },
      "B": {
        "datasourceUID": "__expr__",
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "datasourceUID": "__expr__",
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              }
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "5m",
    "labels": {
      "domain": "observability",
      "page": "true",
      "service": "agent-history",
      "severity": "critical",
      "source": "agent-history"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "agent-history metric collection stopped",
    "trigger": {
      "interval": "1m"
    }
  }
}
