{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "labels": {
      "grafana.app/folder": "REPLACE_WITH_FOLDER_UID"
    },
    "name": "agent-history-hot-retention-backlog"
  },
  "spec": {
    "annotations": {
      "description": "Files past the hot retention window remain in the hot tier. The archive service prunes them only after a successful copy to the cold tier.",
      "summary": "{{ $values.A.Value | printf \"%.0f\" }} hot JSONL files are past retention"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max(agent_sessions_hot_retention_eligible_files{job=\"agent-history-index\"}) > 0",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        "queryType": "instant",
        "relativeTimeRange": {
          "from": "15m",
          "to": "0s"
        }
      },
      "B": {
        "datasourceUID": "__expr__",
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "datasourceUID": "__expr__",
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              }
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "36h",
    "labels": {
      "domain": "observability",
      "page": "false",
      "service": "agent-history",
      "severity": "warning",
      "skipinvestigation": "true",
      "source": "agent-history"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "agent-history hot retention backlog",
    "trigger": {
      "interval": "1m"
    }
  }
}
