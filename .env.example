# docker compose reads .env from this directory. Use long random values, for example:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
AH_WRITER_PASSWORD=
AH_READER_PASSWORD=
# Required DSNs on the internal Compose network: db:5432/agent_history.
# Use ah_writer and ah_reader with their corresponding passwords, URL-encoded if needed.
AGENT_HISTORY_DSN=
AGENT_HISTORY_READER_DSN=
# Required absolute host paths: existing transcript tree and readable container-path TOML config.
TRANSCRIPTS_ROOT=
AGENT_HISTORY_CONFIG_FILE=
# Optional: defaults are 60-second worker intervals.
# INDEX_INTERVAL_SECONDS=
# EMBED_INTERVAL_SECONDS=
